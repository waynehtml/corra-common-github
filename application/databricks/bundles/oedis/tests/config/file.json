{
  "pipeline": "storage_volume_to_volume",
  "tasks": [
    {
      "id": "download",
      "handler": "oedis.handler.storage.download",
      "params": {
        "connection": {
          "uri": "/Volumes/dev_application_cat/oedisint_db/land-oedataservices/oedis/data/"
        },
        "requests": [
          {
            "recursive": true
          }
        ]
      }
    },
    {
      "id": "rename",
      "handler": "oedis.handler.file.copy",
      "params": {
        "requests": [
          {
            "src_dir": "a",
            "recursive": true,
            "dst_dir": ""
          }
        ]
      }
    },
    {
      "id": "delete",
      "handler": "oedis.handler.file.delete",
      "params": {
        "requests": [
          {
            "include": ["*.json"],
            "recursive": true
          }
        ]
      }
    },
    {
      "id": "upload",
      "handler": "oedis.handler.storage.upload",
      "params": {
        "connection": {
          "uri": "/Volumes/dev_application_cat/oedisint_db/land-oedataservices/oedis/data-aa/"
        },
        "requests": [
          {
            "recursive": true
          }
        ]
      }
    }
  ]
}