{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oedis/schema/oedis.handler.database.download.json",
  "title": "Task params for oedis.handler.database.download",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requests"
  ],
  "properties": {
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/databaseDownloadRequest"
      }
    }
  },
  "$defs": {
    "databaseDownloadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "select_sql": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "parquet"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Output file path under ctx.inbox. Leading / is treated as inbox-rooted shorthand and the resolved path must stay inside ctx.inbox."
        },
        "write": {
          "$ref": "#/$defs/databaseDownloadWrite"
        }
      },
      "anyOf": [
        {
          "required": [
            "select_sql"
          ]
        },
        {
          "required": [
            "table"
          ]
        }
      ]
    },
    "databaseDownloadWrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
