{
  "id": "download",
  "handler": "oedis.handler.rest.download",
  "params": {
    "connection": {
      "timeout_sec": 45,
      "headers": {
        "Accept": "text/csv"
      }
    },
    "requests": [
      {
        "id": "export_csv",
        "method": "POST",
        "url": "https://example/api/export",
        "body_mode": "form",
        "body": {
          "start_date": "{{ delta(days=-1) }}",
          "end_date": "{{ rundate }}",
          "format": "csv"
        },
        "file": "raw/export_{{ rundate }}.csv",
        "fault_tolerant": {
          "retries": 1,
          "retry_interval_sec": 5,
          "retry_on_status": [500, 502, 503]
        }
      }
    ]
  }
}
