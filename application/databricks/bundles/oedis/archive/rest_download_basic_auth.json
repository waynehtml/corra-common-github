{
  "id": "download",
  "handler": "oedis.handler.rest.download",
  "params": {
    "connection": {
      "timeout_sec": 60,
      "headers": {
        "Accept": "application/json",
        "Authorization": "Basic {{ basic_auth(username=keyvault(scope=\"dis-secrets\", key=\"api_user\"), password=keyvault(scope=\"dis-secrets\", key=\"api_password\")) }}"
      },
      "fault_tolerant": {
        "retries": 3,
        "retry_interval_sec": 30,
        "retry_on_status": [429, 500, 502, 503, 504]
      }
    },
    "requests": [
      {
        "id": "get_report",
        "method": "GET",
        "url": "https://example/api/report",
        "headers": {
          "r": "abc"
        },
        "query": {
          "date": "{{ rundate }}"
        },
        "body_mode": "json",
        "body": [
          {
            "vectorId": "{{ param(name=\"vectorId\") }}"
          }
        ],
        "file": "raw/report_{{ rundate }}.json"
      }
    ]
  }
}
